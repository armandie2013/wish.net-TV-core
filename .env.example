# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/wishnet_tv_core

# JWT
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_SEGURA

# App
APP_NAME=wish.net-TV
NODE_ENV=development

# Worker / health check de servidores origin-edge
# Cada cuánto consultar /health de los servidores.
STREAMING_HEALTH_INTERVAL_MS=30000

# Cuántos servidores consultar en paralelo por tanda.
STREAMING_HEALTH_BATCH_SIZE=4